# ─────────────────────────────────────────────────────────────────────
# agentv3 — Botmother AI Agent (Claude Code level)
# ─────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8100
AGENT_LOG_LEVEL=INFO
AGENT_CORS_ORIGINS=http://localhost:3010,http://localhost:3001

# ── LLM provider routing ───────────────────────────────────────────────
# Tanlash: anthropic | openai | bedrock
AGENT_LLM_PROVIDER=openai

# Asosiy modellar (rolelarga ko'ra)
AGENT_MODEL_PLANNER=gpt-5.2
AGENT_MODEL_EXECUTOR=gpt-5.2
AGENT_MODEL_CRITIC=gpt-5.2
AGENT_MODEL_EMBEDDING=text-embedding-3-small

# API keys (kerakli provider uchun)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Budget guardrails (per run)
AGENT_MAX_INPUT_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_TOOL_CALLS=80
AGENT_MAX_WALL_SECONDS=900

# ── Persistence ────────────────────────────────────────────────────────
# Postgres + pgvector (single instance)
AGENT_DATABASE_URL=postgresql+psycopg://agentv3:agentv3@localhost:5433/agentv3
AGENT_REDIS_URL=redis://localhost:6380/0

# ── External services ──────────────────────────────────────────────────
# Django backend (project/release/env/file)
BACKEND_BASE_URL=http://localhost:8000
BACKEND_INTERNAL_TOKEN=

# MongoDB (CRM — project-scoped DBs)
MONGO_BASE_URL=mongodb://localhost:27017
MONGO_DB_PREFIX=project_

# Engine-golang (optional, for log streaming / debug)
ENGINE_BASE_URL=http://localhost:9100

# ── Auth ───────────────────────────────────────────────────────────────
# JWT secret shared with dashboard (SESSION_SECRET in dashboard's .env)
SESSION_SECRET=change-me-to-a-32-char-secret-string
JWT_ALGORITHM=HS256

# Internal API token (server-to-server, ex: backend calling agent)
AGENT_INTERNAL_API_TOKEN=

# ── Memory / RAG ───────────────────────────────────────────────────────
# pgvector lives inside AGENT_DATABASE_URL; just enable
AGENT_RAG_ENABLED=true
AGENT_RAG_TOP_K=6

# ── Observability ──────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=botmother-agentv3
