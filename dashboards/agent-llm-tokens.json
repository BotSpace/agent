{
  "title": "Botmother Agent — LLM tokens & cache",
  "uid": "botmother-agent-llm",
  "tags": ["botmother", "agent", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(agent_llm_input_tokens_total, model)",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(agent_llm_input_tokens_total, provider)",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "cache_read / prompt_total — caching samaradorligi. Maqsad: 50%+",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_input_tokens_total{category=\"cache_read\", provider=~\"$provider\", model=~\"$model\"}[5m])) / sum(rate(agent_llm_input_tokens_total{category=\"prompt_total\", provider=~\"$provider\", model=~\"$model\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache reuse (read / write)",
      "description": "Har 1 ta cache_write nechta marta o'qiladi. Maqsad: 3x+",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_input_tokens_total{category=\"cache_read\", provider=~\"$provider\", model=~\"$model\"}[1h])) / sum(rate(agent_llm_input_tokens_total{category=\"cache_write\", provider=~\"$provider\", model=~\"$model\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1.5 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total tokens / hour",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_input_tokens_total{category=\"prompt_total\", provider=~\"$provider\", model=~\"$model\"}[5m])) * 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Output / hour",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_output_tokens_total{provider=~\"$provider\", model=~\"$model\"}[5m])) * 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Input tokens by cache state (rate)",
      "description": "cache_read (yashil), cache_write (sariq), uncached (qizil) — har 5m oraliqda",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"cache_read\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "cache_read", "refId": "A" },
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"cache_write\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "cache_write", "refId": "B" },
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"uncached\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "uncached", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cache_read" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "cache_write" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "uncached" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Input tokens by section (local estimate)",
      "description": "Tokenlar qaysi qism'da yo'qoladi: tool_schema, user history, system, tool_result",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"tool_schema\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "tool_schema", "refId": "A" },
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"user\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "user", "refId": "B" },
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"system\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "system", "refId": "C" },
        { "expr": "sum(rate(agent_llm_input_tokens_total{category=\"tool_result\", provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "tool_result", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 20,
      "type": "piechart",
      "title": "Section share (last 1h)",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (category) (increase(agent_llm_input_tokens_total{category=~\"system|tool_schema|user|tool_result\", provider=~\"$provider\", model=~\"$model\"}[1h]))", "legendFormat": "{{category}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut" }
    },
    {
      "id": 21,
      "type": "piechart",
      "title": "Cache state share (last 1h)",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (category) (increase(agent_llm_input_tokens_total{category=~\"cache_read|cache_write|uncached\", provider=~\"$provider\", model=~\"$model\"}[1h]))", "legendFormat": "{{category}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "donut" }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Cost saved by cache (last 24h, $)",
      "description": "Taxminiy: cache_read 90% arzonroq (Qwen). Aniqlik uchun pricing'ingizni qo'ying.",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(agent_llm_input_tokens_total{category=\"cache_read\", provider=~\"$provider\", model=~\"$model\"}[24h])) * 0.9 * 0.5 / 1000000", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "LLM request rate by outcome",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (outcome) (rate(agent_llm_requests_total{provider=~\"$provider\", model=~\"$model\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "LLM request duration (p50 / p95 / p99)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(agent_llm_request_duration_seconds_bucket{provider=~\"$provider\", model=~\"$model\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_llm_request_duration_seconds_bucket{provider=~\"$provider\", model=~\"$model\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(agent_llm_request_duration_seconds_bucket{provider=~\"$provider\", model=~\"$model\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 40,
      "type": "table",
      "title": "Tokens by category — cumulative",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (category) (agent_llm_input_tokens_total{provider=~\"$provider\", model=~\"$model\"})", "format": "table", "instant": true, "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "tokens" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "tokens", "desc": true }] } }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ]
}
